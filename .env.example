# COS-Monitor Environment Variables
# Copy to .env and fill in values

# Database
POSTGRES_PASSWORD=cosmonitor

# Redis
REDIS_URL=redis://redis:6379

# Observation Bus
OBSERVATION_BUS_URL=redis://redis:6379

# Database (collector-service persists observations here)
DATABASE_URL=postgresql+asyncpg://cosmonitor:cosmonitor@localhost:5433/cosmonitor

# Collector Service (Evidence Organizer)
CONSUMER_GROUP=evidence_organizers
CONSUMER_NAME=collector-1
HEALTH_PORT=8090

# Evidence Organizer - organization windows (minutes) and thresholds per domain
# (defaults match docs/02-motor-recoleccion.md; applied at Evidence creation)
RESOURCE_EXHAUSTION_WINDOW_MINUTES=5
SERVICE_DEGRADATION_WINDOW_MINUTES=15
AUTH_ANOMALY_WINDOW_MINUTES=60
BACKUP_FAILURE_WINDOW_MINUTES=60
VMWARE_CAPACITY_WINDOW_MINUTES=30
NETWORK_ANOMALY_WINDOW_MINUTES=15
NETWORK_ANOMALY_ERROR_THRESHOLD=100
BACKUP_REPO_FREE_PERCENT=10
VMWARE_DATASTORE_FREE_PERCENT=15
VMWARE_SNAPSHOT_AGE_DAYS=7

# Context Service (Context Activator) - activa el modelo mental más coherente
# por tenant+purpose (competencia de coherencia P2). Puerto propio
# (ACTIVATOR_HEALTH_PORT) para no chocar con el collector (HEALTH_PORT=8090)
# cuando ambos corren en el mismo host.
ACTIVATION_CYCLE_SECONDS=30
ACTIVATOR_HEALTH_PORT=8091

# Pattern Service (Pattern Detector) - detecta regularidades recurrentes sobre
# el stream de contexts (Reasoning - Generalize). Puerto propio
# (PATTERN_HEALTH_PORT) para no chocar con el collector (8090) ni con el
# context-service (8091). DETECTION_WINDOW_DAYS es la ventana de evaluación del
# detector (default 28 días; los contexts anteriores a la ventana se excluyen).
DETECTION_CYCLE_SECONDS=60
DETECTION_WINDOW_DAYS=28
PATTERN_HEALTH_PORT=8092

# Anomaly Service (Anomaly Detector) - compara cada Active Context contra su
# patrón esperado y mide la desviación (Reasoning - Detect Deviation). Puerto
# propio (ANOMALY_HEALTH_PORT) para no chocar con collector (8090), context
# (8091) ni pattern (8092). ANOMALY_CYCLE_SECONDS es el periodo del ciclo de
# detección.
# Las tolerancias son declarativas (procedural memory) en
# libs/procedural_memory/tolerance_library.py: umbrales EXPLÍCITOS, auditable y
# purpose-dependent. Los defaults canónicos viven ahí; por despliegue se pueden
# ajustar con las TOLERANCE_*_THRESHOLD (valor = ratio que deviation_score debe
# superar; schedule = días_off_schedule, clustering = count_exceeding_window).
ANOMALY_CYCLE_SECONDS=60
ANOMALY_HEALTH_PORT=8093
TOLERANCE_SCHEDULE_DEVIATION_CAPACITY_RISK_THRESHOLD=0.5
TOLERANCE_CLUSTERING_DEVIATION_SERVICE_FAILURE_THRESHOLD=1.0
TOLERANCE_SCHEDULE_DEVIATION_RESOURCE_PRESSURE_THRESHOLD=0.5
TOLERANCE_CLUSTERING_DEVIATION_AUTH_COMPROMISE_THRESHOLD=1.0
TOLERANCE_SCHEDULE_DEVIATION_CONNECTIVITY_DEGRADATION_THRESHOLD=0.5

# Hypothesis Service (Hypothesis Generator) - propone explicaciones testables
# (candidatas) para cada anomalía point (Reasoning - Predict). Puerto propio
# (HYPOTHESIS_HEALTH_PORT) para no chocar con collector (8090), context (8091),
# pattern (8092) ni anomaly (8093). HYPOTHESIS_CYCLE_SECONDS es el periodo del
# ciclo de generación.
# Las plantillas de hipótesis son declarativas (procedural memory) en
# libs/procedural_memory/hypothesis_templates.py: explicación + predicciones
# observables + criterio de falsificación, por dominio. LM_STUDIO_URL (sección
# de abajo) es la capacidad externa opcional (ADR-0002); si no está disponible
# el generator usa solo las plantillas internas (nunca se queda sin salida).
HYPOTHESIS_CYCLE_SECONDS=60
HYPOTHESIS_HEALTH_PORT=8094

# Confidence Service (Confidence Calibrator) - computa la Confidence calibrada
# (S + C + ECE + C_final) de cada juicio bajo evaluación (Learning - Calibrate).
# Puerto propio (CONFIDENCE_HEALTH_PORT) para no chocar con collector (8090),
# context (8091), pattern (8092), anomaly (8093) ni hypothesis (8094).
# CONFIDENCE_CYCLE_SECONDS es el periodo del ciclo de calibración.
# CALIBRATION_ALPHA y CALIBRATION_ECE_BINS son los parámetros del Calibration
# Model fijados A PRIORI y publicados en cada calibration_justification (nunca
# se tunifican para justificar una confianza; L0 queda fijo en 0 = prior no
# informativo). Sin historial de outcomes el factor (1-ECE) es 1.0 (primeros
# datos, documentado).
CONFIDENCE_CYCLE_SECONDS=60
CONFIDENCE_HEALTH_PORT=8095
CALIBRATION_ALPHA=0.5
CALIBRATION_ECE_BINS=10

# Recommendation Service (Recommendation Formulator) - propone el curso de acción
# que mejor sirve al propósito actual dentro del action space explícito (Action -
# Propose). Puerto propio (RECOMMENDATION_HEALTH_PORT) para no chocar con collector
# (8090), context (8091), pattern (8092), anomaly (8093), hypothesis (8094) ni
# confidence (8095). RECOMMENDATION_CYCLE_SECONDS es el periodo del ciclo de
# formulación. ACTION_SPACE_DOMAINS es el flag de action space: lista de dominios
# habilitados separada por comas (vacío = todos los dominios del catálogo de
# libs/procedural_memory/action_space.py; la recomendación SOLO elige dentro de
# los dominios habilitados).
RECOMMENDATION_CYCLE_SECONDS=60
RECOMMENDATION_HEALTH_PORT=8096
ACTION_SPACE_DOMAINS=

# Decision Service (Decision Committer) - commitea el curso de acción definitivo
# bajo autoridad con expected outcomes falsificables (Action - Commit). Puerto
# propio (DECISION_HEALTH_PORT) para no chocar con collector (8090), context
# (8091), pattern (8092), anomaly (8093), hypothesis (8094), confidence (8095)
# ni recommendation (8096). DECISION_CYCLE_SECONDS es el periodo del ciclo de
# commit. DECISION_MIN_CONFIDENCE / DECISION_MIN_CONFIDENCE_IRREVERSIBLE son los
# umbrales de commit e irreversible (docs/03: "> 0.75 to commit; > 0.9 for
# irreversible"); se aplican sobre el catálogo canónico de policies
# (libs/procedural_memory/decision_policy.py). El committer NO ejecuta acciones
# reales (P6): registra la Decision con sus outcomes falsificables; la ejecución,
# autorización real (Sprint 12) y el learning loop son fases futuras.
DECISION_CYCLE_SECONDS=60
DECISION_HEALTH_PORT=8097
DECISION_MIN_CONFIDENCE=0.75
DECISION_MIN_CONFIDENCE_IRREVERSIBLE=0.9

# Report Service (Report Generator) - formatea lo que el flujo cognitivo ya
# commiteó (Decisiones, Recomendaciones, Contexts, Confidences y su traza) en
# documentos ejecutivo/técnico/JSON (FASE 6). Capacidad externa NO-canónica
# (ADR-0002): SOLO formatea y escribe en su tabla propia ``reports``; nunca
# genera juicios ni escribe en las tablas cognitivas (P1). Puerto propio
# (REPORT_HEALTH_PORT) para no chocar con collector (8090), context (8091),
# pattern (8092), anomaly (8093), hypothesis (8094), confidence (8095),
# recommendation (8096) ni decision (8097). REPORT_CYCLE_SECONDS es el periodo
# del ciclo de generación; REPORT_OUTPUT_DIR es el directorio donde se escriben
# los artefactos (PDF para executive/technical, JSON para el report json).
REPORT_CYCLE_SECONDS=60
REPORT_HEALTH_PORT=8098
REPORT_OUTPUT_DIR=reports

# Windows Agent (WMI over WinRM)
WINRM_HOST=server.example.com
WINRM_PORT=5986
WINRM_USER=cosmonitor
WINRM_PASSWORD=change-me
WINRM_TRANSPORT=ntlm
WINRM_SERVER_CERT_VALIDATION=validate

# VMware Agent (vSphere API)
VCENTER_HOST=vcenter.example.com
VCENTER_PORT=443
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=change-me

# LM Studio (capacidad externa NO-canónica, ADR-0002; usada por el
# Hypothesis Service como herramienta de diversidad, nunca como fuente de
# verdad. Si no responde, el flujo canónico usa solo templates.)
LM_STUDIO_URL=http://lm-studio:1234/v1

# JWT (Sprint 12, user-service + API Gateway)
# Dev: HS256 with JWT_SECRET_KEY (default). Prod: RS256 with a keypair -
# set JWT_ALGORITHM=RS256 and provide JWT_PRIVATE_KEY (signing) +
# JWT_PUBLIC_KEY (verification). Access tokens expire in minutes, refresh in
# days. Token revocation uses Redis-backed blacklist (JWT_REDIS_URL).
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REDIS_URL=redis://localhost:6379/1
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...

# User Service (auth/RBAC, external ADR-0002) - emite JWTs con rol y tenant.
# Puerto propio (USER_HEALTH_PORT=8099) para no chocar con los servicios del
# pipeline (8090-8098). El user-service autentica/autoriza; NUNCA produce
# juicios cognitivos (ADR-0002) ni ejecuta el pipeline.
USER_HEALTH_PORT=8099

# API Gateway (Cognitive Boundary enforcement, R3, external ADR-0002) -
# valida los JWTs del user-service, extrae tenant+rol y enruta/protege el
# acceso al pipeline. Puerto propio (GATEWAY_HEALTH_PORT=8100).
# GATEWAY_SERVICE_HEALTH opcional: override de los targets /health
# (formato "servicio=url,servicio=url"); por defecto usa los puertos canónicos
# 8090-8099.
GATEWAY_HEALTH_PORT=8100

# API Gateway
TRAEFIK_DASHBOARD=true

# Tenant/Source IDs for agents (override per deployment)
TENANT_ID=00000000-0000-0000-0000-000000000001
SOURCE_ID=00000000-0000-0000-0000-000000000001

# Collection interval (seconds)
COLLECTION_INTERVAL_SECONDS=60